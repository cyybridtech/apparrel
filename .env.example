PORT=3001
VITE_API_URL=http://localhost:3001

# Required for local API sessions; generate with: openssl rand -hex 32
SESSION_SECRET=

# Local development bootstrap administrator. Never use example values in production.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Payment settings. Live payment flow still requires server-side verification before orders can be confirmed.
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=GHS

# Mapbox Access Token
VITE_MAPBOX_TOKEN=

# TiDB Cloud connection string. Do not run demo seed scripts against the live database.
DATABASE_URL=
DATABASE_SSL_CA=
ALLOW_DEMO_SEED=false
